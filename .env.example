# FixMate backend — copy to .env and adjust
PORT=3000
NODE_ENV=development

# MySQL (created by sql/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=fixmate
DB_PASSWORD=fixmate_pass
DB_NAME=fixmate

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Frontend origin allowed by CORS (the static site is served by this server too)
FRONTEND_URL=http://localhost:3000

# Initial Super Admin (created via: npm run create-admin)
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@fixmate.demo
ADMIN_PASSWORD=ChangeMe123!
